# Copy to .dev.vars for `npm run cf:dev`, or set as secrets on the Cloudflare Worker / env vars on Vercel.
# None of these are ever sent to the browser.

# Signs sign-in links and OAuth state. 32+ random characters: openssl rand -base64 48
AUTH_SECRET=

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client, Web application).
# Authorized redirect URI: https://agartala.biratdatta.tech/api/auth-google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in links (optional): https://resend.com API key, plus a sender on a domain you verified there.
RESEND_API_KEY=
EMAIL_FROM=Haora Bari <login@biratdatta.tech>

# Storage. On Cloudflare the D1 binding "DB" (wrangler.toml) is used automatically.
# On Vercel use Supabase instead (supabase/schema.sql):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
